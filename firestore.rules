rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers (lisibilité + validation) =====
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Un tableau ne peut que basculer l'uid de l'appelant (follow, likedBy, viewedBy…)
    function togglesSelfOnly(field) {
      return
        ( request.resource.data[field].hasAny([request.auth.uid]) &&
          ( !(field in resource.data) || !resource.data[field].hasAny([request.auth.uid]) ) )
        ||
        ( (field in resource.data) &&
          resource.data[field].hasAny([request.auth.uid]) &&
          !request.resource.data[field].hasAny([request.auth.uid]) );
    }

    // ===== Audience (qui peut interagir avec un utilisateur) =====
    // Lit le réglage `whoCanXxx` du destinataire dans sa sous-collection privée
    // settings/preferences. Retourne 'everyone' par défaut si le doc n'existe pas
    // encore (rétro-compatibilité).
    function audiencePref(uid, field) {
      return get(/databases/$(database)/documents/users/$(uid)/settings/preferences).data[field] || 'everyone';
    }
    function audienceAllows(targetUid, callerUid, audience) {
      return audience == 'everyone' || (audience == 'followers' && get(/databases/$(database)/documents/users/$(targetUid)).data.followers.hasAny([callerUid]));
    }
    function canInteract(targetUid, prefField) {
      return audienceAllows(targetUid, request.auth.uid, audiencePref(targetUid, prefField));
    }

    function videoAuthor(vid) {
      return get(/databases/$(database)/documents/videos/$(vid)).data.userId;
    }

    function otherParticipant(convId) {
      let conv = get(/databases/$(database)/documents/conversations/$(convId)).data;
      return conv.participants[0] == request.auth.uid ? conv.participants[1] : conv.participants[0];
    }

    match /users/{userId} {
      // ⚠️ read public conservé pour u/[pseudo] + deep links.
      // NE STOCKE JAMAIS email/tel/données privées dans ce doc.
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        (changedKeys().hasOnly(['followers','followerCount']) && togglesSelfOnly('followers')) ||
        (changedKeys().hasOnly(['followers','followerCount']) &&
         'followers' in resource.data &&
         resource.data.followers.hasAny([request.auth.uid]) &&
         !request.resource.data.followers.hasAny([request.auth.uid])) ||
        (changedKeys().hasOnly(['pendingFollowers']) && togglesSelfOnly('pendingFollowers')) ||
        (changedKeys().hasOnly(['pendingFollowers']) &&
         'pendingFollowers' in resource.data &&
         resource.data.pendingFollowers.hasAny([request.auth.uid]) &&
         !request.resource.data.pendingFollowers.hasAny([request.auth.uid])) ||
        (changedKeys().hasOnly(['pendingFollowings']) &&
         'pendingFollowings' in resource.data &&
         resource.data.pendingFollowings.hasAny([request.auth.uid]) &&
         !request.resource.data.pendingFollowings.hasAny([request.auth.uid])) ||
        (changedKeys().hasOnly(['following','followingCount','pendingFollowings']) &&
         request.resource.data.following.hasAny([request.auth.uid]) &&
         (!('following' in resource.data) || !resource.data.following.hasAny([request.auth.uid])) &&
         'pendingFollowings' in resource.data &&
         resource.data.pendingFollowings.hasAny([request.auth.uid]) &&
         !request.resource.data.pendingFollowings.hasAny([request.auth.uid])) ||
        // blocage : seul l'appelant peut (se) toggler dans blockedBy
        (changedKeys().hasOnly(['blockedBy','followers','following']) && togglesSelfOnly('blockedBy'))
      );
      allow delete: if isOwner(userId);

      // ✅ Réglages privés (paramètres & confidentialité). Contrairement au doc
      // user (lecture publique), cette sous-collection est STRICTEMENT réservée
      // au propriétaire — c'est ici que vivent les préférences privées, jamais
      // dans le doc user. Synchronisé entre appareils via onSnapshot.
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Le mapping username appartient à l'appelant (uid)
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /videos/{videoId} {
      allow read: if isSignedIn();
      // l'auteur déclaré = l'appelant ; moderationStatus/hiddenAt/hiddenReason SERVER-ONLY
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && !('moderationStatus' in request.resource.data)
        && !('hiddenAt' in request.resource.data)
        && !('hiddenReason' in request.resource.data);
      // ✅ VERROU : compteurs & tableaux (likes/likedBy/saves/savedBy/reposts/
      // repostedBy/latestRepostedBy/comments/previewComments/shares/views) sont
      // possédés par les Cloud Functions (Admin SDK). Le client ne touche le doc
      // vidéo que s'il en est l'auteur, et jamais les champs de modération.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && !changedKeys().hasAny(['moderationStatus','hiddenAt','hiddenReason']);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;

      // vue par user (onViewCreate côté serveur)
      match /views/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
      }
      match /saves/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
      }
      match /comments/{commentId} {
        allow read: if isSignedIn();
        // auteur = appelant, texte borné, et respect du réglage whoCanComment
        // de l'auteur de la vidéo (le destinataire du commentaire).
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && canInteract(videoAuthor(videoId), 'whoCanComment');
        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.userId ||
          ( changedKeys().hasOnly(['likes','likedBy','dislikes','dislikedBy','replyCount'])
            && ( !changedKeys().hasAny(['likedBy'])    || togglesSelfOnly('likedBy') )
            && ( !changedKeys().hasAny(['dislikedBy']) || togglesSelfOnly('dislikedBy') )
          )
        );
        allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;

        match /replies/{replyId} {
          allow read: if isSignedIn();
          // Une réponse commente aussi un contenu : soumise au whoCanComment
          // de l'auteur de la vidéo parente.
          allow create: if isSignedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && canInteract(videoAuthor(videoId), 'whoCanComment');
          allow update: if isSignedIn() && (
            request.auth.uid == resource.data.userId ||
            ( changedKeys().hasOnly(['likes','likedBy','dislikes','dislikedBy'])
              && ( !changedKeys().hasAny(['likedBy'])    || togglesSelfOnly('likedBy') )
              && ( !changedKeys().hasAny(['dislikedBy']) || togglesSelfOnly('dislikedBy') )
            )
          );
          allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
        }
      }
    }

    match /messages/{messageId} {
      allow read: if isSignedIn()
        && resource.data.participants != null
        && resource.data.participants.hasAny([request.auth.uid]);
      // expéditeur = appelant ET participant
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.participants.hasAny([request.auth.uid]));
      allow create: if isSignedIn()
        && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isSignedIn()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        // whoCanMessage : évalue les préférences du destinataire.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && canInteract(otherParticipant(conversationId), 'whoCanMessage');
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ( changedKeys().hasOnly(['views','viewedBy']) && togglesSelfOnly('viewedBy') )
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /reposts/{repostId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /highlights/{highlightId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /shares/{shareId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      allow update: if false;
    }

    match /posts/{postId} {
      allow list: if request.auth != null;
      allow get: if request.auth != null && (
        resource.data.visibility == 'public' ||
        resource.data.userId == request.auth.uid ||
        (resource.data.visibility == 'followers' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.following.hasAny([resource.data.userId]))
      );

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.format in [
          'text', 'image', 'carousel', 'video', 'article', 'video_share'
        ]
        && request.resource.data.visibility in [
          'public', 'followers', 'private'
        ]
        // `verified` est dénormalisé depuis le doc user à la création : on
        // interdit de l'inventer côté client (l'update est bloqué plus bas).
        && (!('verified' in request.resource.data)
            || request.resource.data.verified ==
               (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true));

      // 🔒 Les agrégats (likes/likedBy/comments/shares/saves/savedBy/
      // reactionCounts/reposts/repostedBy) sont possédés par les Cloud
      // Functions. Le mobile n'exprime que ses intentions dans les
      // sous-collections ci-dessous ; seul l'auteur édite son document,
      // et jamais les champs de comptage (recalculés par le backend).
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'likes', 'likedBy', 'comments', 'shares', 'saves', 'savedBy',
          'reactionCounts', 'reposts', 'repostedBy', 'verified'
        ]);

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update: if request.auth != null && (
          request.auth.uid == resource.data.userId ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes', 'likedBy'
          ])
        );

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }

      match /reactions/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type in ['like', 'love', 'fire', 'clap'];
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type in ['like', 'love', 'fire', 'clap']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['type', 'updatedAt']);
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /saves/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /reposts/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /shares/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /pollVotes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.optionId is string;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['optionId', 'updatedAt']);
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Historique des republications d'un utilisateur (feature repost).
    match /users/{userId}/reposts/{postId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string
        && request.resource.data.targetId is string;
      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
